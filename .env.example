# Copiar a .env (gitignored) y completar. Vite las lee en build time: definirlas antes de `npm run build`.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Debe ser exactamente el audience del JWT authorizer del API Gateway (y de AUTH0_AUDIENCE en master).
VITE_AUTH0_AUDIENCE=
# https://api.tiburonshark.me en prod. Vacío: rutas relativas por el proxy de Vite hacia master local (:3001).
VITE_API_BASE_URL=
# Solo en `npm run dev`: true responde el historial de ciclos (RF01), el libro de ofertas y la distance-table
# (RF02) desde src/mocks/ (DF-025, DF-038). Se borra en S23. Sin editar el .env: `npm run dev:mocks` (.env.mocks).
VITE_USE_MOCKS=false
